# Required provider credentials
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Workers AI renders final artwork with FLUX.1 Schnell.
# Gemini plans, ranks, and critiques.
CLOUDFLARE_FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_FLUX_STEPS=4
CLOUDFLARE_TIMEOUT_SECONDS=150
GEMINI_TIMEOUT_SECONDS=150
GEMINI_CONCEPT_MODEL=gemini-3.6-flash
GEMINI_CRITIC_MODEL=gemini-3.6-flash
USE_GEMINI_CREATIVE_DIRECTOR=true

# Major-label quality pipeline: 8 concepts -> top 2 -> 2 renders each -> 4 covers.
CONCEPT_COUNT=8
SELECTED_CONCEPT_COUNT=2
RENDERS_PER_CONCEPT=2
MAX_PARALLEL_RENDERS=2
ENABLE_CONCEPT_RANKING=true
ENABLE_COVER_CRITIC=true
ENABLE_PLATFORM_SCORING=true
ENABLE_MARKET_POSITIONING=false
ENABLE_COMMERCIAL_BENCHMARKING=false

# Production persistence. Render may supply postgres:// or postgresql://; both are normalized.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
# STORAGE_ROOT=/absolute/path/to/storage
# FRONTEND_ROOT=/absolute/path/to/frontend
AUTO_CREATE_SCHEMA=false
APP_ENV=production

MAX_AUDIO_MB=30
MAX_LYRICS_CHARS=50000
AUDIO_ANALYSIS_MAX_SECONDS=180
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.75
CORS_ORIGINS=http://localhost:5173
ALLOW_MOCK_IMAGES=false
