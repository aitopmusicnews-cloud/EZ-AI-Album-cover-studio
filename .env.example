# Required for real image generation
OPENAI_API_KEY=

# OpenAI Image API
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_TIMEOUT_SECONDS=150

# Persistence. Leave these unset to use project-local defaults.
# DATABASE_URL=sqlite:////absolute/path/to/album-cover-studio/data/album_covers.db
# STORAGE_ROOT=/absolute/path/to/album-cover-studio/data/storage
# FRONTEND_ROOT=/absolute/path/to/album-cover-studio/frontend
AUTO_CREATE_SCHEMA=true

# Input/resource limits
MAX_AUDIO_MB=30
MAX_LYRICS_CHARS=50000
AUDIO_ANALYSIS_MAX_SECONDS=180

# Retry policy
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.75

# Comma-separated origins when the API is used by a separate frontend.
CORS_ORIGINS=http://localhost:5173

# Development only. Produces placeholder images when no API key is present.
ALLOW_MOCK_IMAGES=false
