APP_ENV=production
AWS_REGION=us-west-2

# RDS PostgreSQL
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@RDS_HOST:5432/albumcovers

# Shared ECS storage. Mount EFS at /data.
STORAGE_ROOT=/data/storage
FRONTEND_ROOT=/workspace/frontend

# AWS queue
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/ACCOUNT_ID/ez-ai-cover-jobs

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_TIMEOUT_SECONDS=180

# Stable worker settings
CONCEPT_COUNT=6
SELECTED_CONCEPT_COUNT=2
RENDERS_PER_CONCEPT=2
MAX_PARALLEL_RENDERS=1
AUDIO_ANALYSIS_MAX_SECONDS=120

ENABLE_CONCEPT_RANKING=true
ENABLE_COVER_CRITIC=true
ENABLE_PLATFORM_SCORING=true
ENABLE_MARKET_POSITIONING=true
ENABLE_COMMERCIAL_BENCHMARKING=true

AUTO_CREATE_SCHEMA=true
ALLOW_MOCK_IMAGES=false
